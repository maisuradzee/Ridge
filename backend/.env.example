# Backend binds to loopback by default. Use a private network + TLS proxy remotely.
RIDGE_HOST=127.0.0.1
PORT=8787
RIDGE_ENV=development
RIDGE_DB_ENV=development
RIDGE_STORAGE=postgres
DATABASE_URL=postgresql://ridge_backend:CHANGE_ME@127.0.0.1:5432/ridge_dev
PGSSL=disable
PG_POOL_MAX=10
# DEVELOPMENT ONLY: shared server token fallback is disabled in production.
RIDGE_SERVER_EVENT_TOKEN=development-only-shared-server-token
# Control-plane secrets: keep separate; never inject these into Dedicated Server processes.
RIDGE_SERVER_PROVISIONING_TOKEN=development-only-provisioning-token
RIDGE_GATEWAY_TOKEN=development-only-gateway-token
# Production requires all OIDC values and a trusted HTTPS reverse proxy.
RIDGE_OIDC_ISSUER=
RIDGE_OIDC_AUDIENCE=
RIDGE_OIDC_JWKS_URL=
RIDGE_TRUST_PROXY=false
# Dedicated Server process only (not the Backend API process):
# RIDGE_SERVER_INSTANCE_ID=<pre-provisioned-unique-id>
# RIDGE_SERVER_EVENT_TOKEN=<one-time-credential-issued-for-that-instance>
RIDGE_DEDICATED_SERVER_ID=development-server-01
RIDGE_RUN_POSTGRES_INTEGRATION=NO