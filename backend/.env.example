# Backend binds to loopback by default. Use a private network + TLS proxy remotely.
RIDGE_HOST=127.0.0.1
PORT=8787
RIDGE_ENV=development
RIDGE_DB_ENV=development
RIDGE_STORAGE=postgres
DATABASE_URL=postgresql://ridge_backend:CHANGE_ME@127.0.0.1:5432/ridge_dev
PGSSL=disable
PG_POOL_MAX=10
RIDGE_SERVER_EVENT_TOKEN=replace-with-a-long-random-secret-in-process-environment
RIDGE_DEDICATED_SERVER_ID=development-server-01
RIDGE_RUN_POSTGRES_INTEGRATION=NO